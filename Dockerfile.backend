# ============================================================
# Dockerfile.backend — Express 5 + better-sqlite3 (runtime tsx)
# ============================================================
# 3 stage:
#   1. build: typecheck del BE — l'immagine è gated su tsc pulito
#   2. deps: npm ci --omit=dev (better-sqlite3 compilato qui se manca
#      il prebuild musl per l'ABI corrente) + smoke test del binding
#   3. runtime: node:24.22.1-alpine (LTS, patch di sicurezza 2026-10-21) SENZA toolchain, utente non-root,
#      /data pre-creata e chown-ata (il named volume eredita
#      l'ownership del mountpoint alla prima creazione)
#   (3a. `rilascio`: lo stage dell'istanza pubblica in sola lettura, L12; si costruisce solo con `--target rilascio` e sta PRIMA del
#      runtime di preparazione, che resta lo stage finale e quindi quello predefinito)
#
# Il pacchetto di gioco iniziale (pacchetto/gioco.db, senza immagini; il completo,
# pacchetto/completo/, e' fuori da git e dall'immagine: si importa dall'app) viaggia
# NELL'IMMAGINE con il file NOTICE delle attribuzioni: al primo boot il backend
# lo copia sul volume /data (gioco.db), crea partite.db accanto e applica le
# migrazioni. Non esiste più un seed JSON.
#
# NB: tsx esegue i .ts direttamente a runtime → tsx/express/pino/
# better-sqlite3/zod DEVONO stare in dependencies. pino-pretty no: in
# produzione il logger scrive JSON e non lo carica (rilievo D11).
# ============================================================

# ---- Stage 1: type-check gate ----
FROM node:24.22.1-alpine AS build
WORKDIR /app
RUN apk add --no-cache python3 make g++
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json tsconfig.server.json ./
COPY server/ ./server/
COPY shared/ ./shared/
COPY scripts/ ./scripts/
RUN npx tsc -b tsconfig.server.json

# ---- Stage 2: production deps ----
FROM node:24.22.1-alpine AS deps
WORKDIR /app
RUN apk add --no-cache python3 make g++
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
# Smoke test del binding nativo: fallisce la BUILD, non il primo boot.
RUN node -e "new (require('better-sqlite3'))(':memory:').close()"
# Le miniature (L1): una vera codifica WebP con il binario musl di sharp/libvips. Senza le voci @img/sharp-linuxmusl-x64 e
# @img/sharp-libvips-linuxmusl-x64 nel lock, `npm ci` qui non installa il binario e la build si ferma.
RUN node -e "require('sharp')({create:{width:2,height:2,channels:4,background:'#000'}}).webp().toBuffer().then(b=>{if(!b.length)process.exit(1);console.log('sharp', require('sharp').versions.sharp, 'vips', require('sharp').versions.vips)}).catch(e=>{console.error(e);process.exit(1)})"

# ---- Stage 3a: rilascio (L12, passo 9) — l'istanza PUBBLICA in sola lettura ----
# Si costruisce SOLO con `--target rilascio` (workflow docker-publish-rilascio.yml). Sta PRIMA dello stage finale apposta: senza `--target` Docker
# costruisce l'ultimo stage, che resta quello di preparazione, quindi la pipeline di `main` non cambia di una riga.
#   - punto d'avvio `server/rilascio.ts`: la modalità «rilascio» è scritta nel codice, non in una variabile dello stack (un errore di
#     configurazione non può aprire le scritture), e non carica l'esecutore delle migrazioni;
#   - NIENTE `pacchetto/`: i contenuti non nascono dall'immagine ma dal volume dell'edizione (prodotto da «Prepara edizione»), montato in sola lettura;
#   - NIENTE cartella d'appoggio (`DEPOSITO_DIR`): nel rilascio non si importa e non si esporta nulla;
#   - tre cartelle, tutte pre-create e di proprietà dell'utente non-root perché il volume nominato ne eredita il proprietario alla prima
#     creazione: `/edizione` (contenuti, montata `:ro` dal compose), `/partite` (il file delle partite, l'unico scrivibile) e `/backup`
#     (copie dell'avanzamento). Il nome delle tre variabili è il contratto con `server/rilascio.ts` e con docker-compose.rilascio.yml.
FROM node:24.22.1-alpine AS rilascio
WORKDIR /app
RUN addgroup -S appgroup && adduser -S appuser -G appgroup \
 && mkdir -p /edizione /partite /backup && chown appuser:appgroup /edizione /partite /backup
COPY --from=deps  /app/node_modules ./node_modules
COPY --from=build /app/server  ./server
COPY --from=build /app/shared  ./shared
COPY package.json tsconfig.json tsconfig.server.json NOTICE ./
COPY licenze/ ./licenze/
ENV NODE_ENV=production \
    EDIZIONE_DIR=/edizione \
    PARTITE_DIR=/partite \
    BACKUP_DIR=/backup \
    PORT=3101
EXPOSE 3101
USER appuser
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "require('http').get('http://localhost:' + (process.env.BE_PORT || process.env.PORT || 3101) + '/api/health', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"
CMD ["node", "--import", "tsx", "server/rilascio.ts"]

# ---- Stage 3: runtime (nessun toolchain) — PREPARAZIONE, lo stage finale: è quello che costruisce `docker build` senza `--target` ----
FROM node:24.22.1-alpine
WORKDIR /app
RUN addgroup -S appgroup && adduser -S appuser -G appgroup \
 && mkdir -p /data && chown appuser:appgroup /data
COPY --from=deps  /app/node_modules ./node_modules
COPY --from=build /app/server  ./server
COPY --from=build /app/shared  ./shared
COPY pacchetto/ ./pacchetto/
COPY package.json tsconfig.json tsconfig.server.json NOTICE ./
# le copie delle licenze citate in NOTICE: i dati derivati (pacchetto/) e Swagger UI viaggiano con la loro licenza
COPY licenze/ ./licenze/
ENV NODE_ENV=production \
    DATA_DIR=/data \
    PACCHETTO_DIR=/app/pacchetto \
    PORT=3101
EXPOSE 3101
USER appuser
# La porta del controllo è quella del server (`BE_PORT`, poi `PORT`, come in server/config.ts), non un numero ripetuto (rilievo D10).
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "require('http').get('http://localhost:' + (process.env.BE_PORT || process.env.PORT || 3101) + '/api/health', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"
# node come PID 1 (non npx): riceve SIGTERM direttamente da `docker stop`.
CMD ["node", "--import", "tsx", "server/index.ts"]
