{
  "name": "project-p5r",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Compagno di gioco per Persona 5 Royal: compendio, motore di fusione, tracking partita",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npx concurrently -n fe,be -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --host",
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b tsconfig.full.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "accesso:copertura": "tsx --env-file=.env scripts/copertura-accesso.ts",
    "pacchetto": "tsx --env-file=.env scripts/genera-pacchetto.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^5.1.0",
    "pino": "^10.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "swagger-ui-dist": "^5.33.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "concurrently": "^9.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.0.2",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
