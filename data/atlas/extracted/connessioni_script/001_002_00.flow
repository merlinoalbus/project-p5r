// Procedure Index: 80
void SUB_PhonePickup()
{
    sVar205 = 0;
    FLD_SET_CELLPHONE(1);
    WAIT(15);
    sVar205 = 1;
    return;
}


// Procedure Index: 81
void SUB_PhoneCall()
{
    sVar206 = FLD_PC_GET_RESHND(0);
    
    if (FLD_UMBREALLA_CHECK_USE() == 1)
    {
        sVar207 = FLD_MODEL_ADDMOTION_LOAD(sVar206, 101);
    }
    else 
    {
        sVar207 = FLD_MODEL_ADDMOTION_LOAD(sVar206, 1);
    }

    FLD_MODEL_LOADSYNC(sVar207);
    FLD_MODEL_COPY_POSE_ANIM(sVar207, sVar206);
    FLD_MODEL_SET_VISIBLE(sVar206, 0, 0);
    FLD_MODEL_SET_VISIBLE(sVar207, 1, 0);
    FLD_CELLPHONE_MODEL_VISIBLE(sVar207, 1);
    MDL_ANIM(sVar207, (60 + 0), 0, 5, 1.00f);
    MDL_ANIM_NEXT(sVar207, (60 + 1), 1, 0, 1.00f);
    sVar205 = 2;
    WAIT(30);
    return;
}


// Procedure Index: 82
void SUB_PhoneTalk()
{
    SUB_PhonePickup();
    SUB_PhoneCall();
    return;
}


// Procedure Index: 83
void SUB_PhoneEnd()
{
    
    if (sVar205 == 0)
    {
        return;
    }

    
    if (sVar205 != 2)
    {
        FLD_SET_CELLPHONE(0);
    }
    else 
    {
        FLD_MODEL_SET_VISIBLE(sVar206, 0, 0);
        FLD_MODEL_SET_VISIBLE(sVar207, 1, 0);
        MDL_ANIM(sVar207, (60 + 2), 0, 10, 1.00f);
        WAIT(65);
        FLD_CELLPHONE_MODEL_VISIBLE(sVar207, 0);
        MDL_ANIM_SYNC(sVar207);
        MDL_ANIM(sVar207, 0, 1, 0, 1.00f);
        MDL_ANIM_BLENDSYNC(sVar207);
        FLD_MODEL_COPY_POSE_ANIM(sVar206, sVar207);
        FLD_MODEL_SET_VISIBLE(sVar206, 1, 0);
        FLD_MODEL_SET_VISIBLE(sVar207, 0, 0);
        FLD_MODEL_FREE(sVar207);
        FLD_SET_CELLPHONE(0);
    }

    sVar205 = 0;
    return;
}

