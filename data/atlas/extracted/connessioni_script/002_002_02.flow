// Procedure Index: 62
void SUB_PhonePickup()
{
    sVar79 = 0;
    FLD_SET_CELLPHONE(1);
    WAIT(15);
    sVar79 = 1;
    return;
}


// Procedure Index: 63
void SUB_PhoneCall()
{
    sVar80 = FLD_PC_GET_RESHND(0);
    
    if (FLD_UMBREALLA_CHECK_USE() == 1)
    {
        sVar81 = FLD_MODEL_ADDMOTION_LOAD(sVar80, 101);
    }
    else 
    {
        sVar81 = FLD_MODEL_ADDMOTION_LOAD(sVar80, 1);
    }

    FLD_MODEL_LOADSYNC(sVar81);
    FLD_MODEL_COPY_POSE_ANIM(sVar81, sVar80);
    FLD_MODEL_SET_VISIBLE(sVar80, 0, 0);
    FLD_MODEL_SET_VISIBLE(sVar81, 1, 0);
    FLD_CELLPHONE_MODEL_VISIBLE(sVar81, 1);
    MDL_ANIM(sVar81, (60 + 0), 0, 5, 1.00f);
    MDL_ANIM_NEXT(sVar81, (60 + 1), 1, 0, 1.00f);
    sVar79 = 2;
    WAIT(30);
    return;
}


// Procedure Index: 64
void SUB_PhoneTalk()
{
    SUB_PhonePickup();
    SUB_PhoneCall();
    return;
}


// Procedure Index: 65
void SUB_PhoneEnd()
{
    
    if (sVar79 == 0)
    {
        return;
    }

    
    if (sVar79 != 2)
    {
        FLD_SET_CELLPHONE(0);
    }
    else 
    {
        FLD_MODEL_SET_VISIBLE(sVar80, 0, 0);
        FLD_MODEL_SET_VISIBLE(sVar81, 1, 0);
        MDL_ANIM(sVar81, (60 + 2), 0, 10, 1.00f);
        WAIT(65);
        FLD_CELLPHONE_MODEL_VISIBLE(sVar81, 0);
        MDL_ANIM_SYNC(sVar81);
        MDL_ANIM(sVar81, 0, 1, 0, 1.00f);
        MDL_ANIM_BLENDSYNC(sVar81);
        FLD_MODEL_COPY_POSE_ANIM(sVar80, sVar81);
        FLD_MODEL_SET_VISIBLE(sVar80, 1, 0);
        FLD_MODEL_SET_VISIBLE(sVar81, 0, 0);
        FLD_MODEL_FREE(sVar81);
        FLD_SET_CELLPHONE(0);
    }

    sVar79 = 0;
    return;
}

