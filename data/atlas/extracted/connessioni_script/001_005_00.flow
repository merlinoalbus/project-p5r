// Procedure Index: 75
void SUB_PhoneCall()
{
    sVar132 = FLD_PC_GET_RESHND(0);
    
    if (FLD_UMBREALLA_CHECK_USE() == 1)
    {
        sVar133 = FLD_MODEL_ADDMOTION_LOAD(sVar132, 101);
    }
    else 
    {
        sVar133 = FLD_MODEL_ADDMOTION_LOAD(sVar132, 1);
    }

    FLD_MODEL_LOADSYNC(sVar133);
    FLD_MODEL_COPY_POSE_ANIM(sVar133, sVar132);
    FLD_MODEL_SET_VISIBLE(sVar132, 0, 0);
    FLD_MODEL_SET_VISIBLE(sVar133, 1, 0);
    FLD_CELLPHONE_MODEL_VISIBLE(sVar133, 1);
    MDL_ANIM(sVar133, (60 + 0), 0, 5, 1.00f);
    MDL_ANIM_NEXT(sVar133, (60 + 1), 1, 0, 1.00f);
    sVar131 = 2;
    WAIT(30);
    return;
}


// Procedure Index: 76
void SUB_PhoneTalk()
{
    SUB_PhonePickup();
    SUB_PhoneCall();
    return;
}


// Procedure Index: 77
void SUB_PhoneEnd()
{
    
    if (sVar131 == 0)
    {
        return;
    }

    
    if (sVar131 != 2)
    {
        FLD_SET_CELLPHONE(0);
    }
    else 
    {
        FLD_MODEL_SET_VISIBLE(sVar132, 0, 0);
        FLD_MODEL_SET_VISIBLE(sVar133, 1, 0);
        MDL_ANIM(sVar133, (60 + 2), 0, 10, 1.00f);
        WAIT(65);
        FLD_CELLPHONE_MODEL_VISIBLE(sVar133, 0);
        MDL_ANIM_SYNC(sVar133);
        MDL_ANIM(sVar133, 0, 1, 0, 1.00f);
        MDL_ANIM_BLENDSYNC(sVar133);
        FLD_MODEL_COPY_POSE_ANIM(sVar132, sVar133);
        FLD_MODEL_SET_VISIBLE(sVar132, 1, 0);
        FLD_MODEL_SET_VISIBLE(sVar133, 0, 0);
        FLD_MODEL_FREE(sVar133);
        FLD_SET_CELLPHONE(0);
    }

    sVar131 = 0;
    return;
}

