// Procedure Index: 49
void D_BRIEFING_SYS()
{
    int var73;
    int var74;
    int var75;
    int var76;
    var73 = FLD_GET_MAJOR();
    var74 = FLD_GET_MINOR();
    FADEOUT(5, 10);
    FADE_SYNC();
    FLD_SMP_EVENT_BEGIN(0);
    FLD_CINEMASCOPE_VISIBLE(1);
    COMMON_FLAG_CLEAR();
    // bit id (536870912) + (4) = 6148
    BIT_ON((0x20000000 + 4));
    // bit id (536870912) + (82) = 6226
    BIT_ON((0x20000000 + 82));
    FLD_NPC_UNDISP(1, 0);
    
    if (var73 < 190)
    {
        FLD_PTY_MODEL_SET_VISIBLE(0, 0);
    }

    // bit id (536870912) + (121) = 6265
    
    if (BIT_CHK((0x20000000 + 121)) == 1)
    {
        DUNGEON_SAFETY_NPC_ON();
    }

    PLAYER_VISIBLE_ON();
    FLD_CAMERA_LOCK();
    var75 = FLD_CAMERA_READ(151, 51, 0);
    FLD_CAMERA_READ_SYNC(var75);
    FLD_CAMERA_SET(var75);
    
    if ((var73 >= 190) && (var73 <= 199))
    {
        FLD_CAMERA_ANIM(var75, 6, 0, 0, 1.00f);
    }
    else 
    {
        FLD_CAMERA_ANIM(var75, 5, 0, 0, 1.00f);
    }

    DUNGEON_POSITION_SET();
    FADEIN(0, 10);
    FADE_SYNC();
    var76 = FLD_SCRIPT_READ(5000, 100, 0);
    FLD_SCRIPT_READ_SYNC(var76);
    FLD_SCRIPT_EXEC(var76, 0);
    FLD_SCRIPT_FREE(var76);
    // bit id (536870912) + (160) = 6304
    
    if (BIT_CHK((0x20000000 + 160)) == 1)
    {
        SCN_FADE_CHOICE();
    }
    else 
    {
        FADEOUT(5, 10);
        FADE_SYNC();
    }

    // bit id (536870912) + (4) = 6148
    BIT_OFF((0x20000000 + 4));
    // bit id (536870912) + (82) = 6226
    BIT_OFF((0x20000000 + 82));
    COMMON_FLAG_CLEAR();
    FLD_CAMERA_SYNC_INTERP();
    FLD_CAMERA_UNLOCK();
    DUNGEON_POSITION_SET();
    PLAYER_VISIBLE_OFF();
    FLD_NPC_UNDISP(1, 1);
    
    if (var73 < 190)
    {
        FLD_PTY_MODEL_SET_VISIBLE(1, 0);
    }

    // bit id (536870912) + (121) = 6265
    
    if (BIT_CHK((0x20000000 + 121)) == 1)
    {
        DUNGEON_SAFETY_NPC_OFF();
    }

    FLD_SMP_EVENT_END(0);
    // bit id (536870912) + (160) = 6304
    // bit id (536870912) + (160) = 6304
    
    if (BIT_CHK((0x20000000 + 160)) == 1)
    {
        BIT_OFF((0x20000000 + 160));
        FLD_CAMERA_RESET();
        FLD_CAMERA_FREE(var75);
        
        if (var73 >= 190)
        {
            GOTO_M_ENTRANCE_ACTION();
        }
        else 
        {
            GOTO_ENTRANCE_ACTION();
        }

    }
    else 
    {
        FLD_CINEMASCOPE_VISIBLE(0);
        FLD_CAMERA_RESET();
        FLD_CAMERA_FREE(var75);
        FLD_ROT_CAMERA(0, 0);
        FADEIN(0, 10);
        FADE_SYNC();
    }

}


