// Procedure Index: 165
void RATWALK_LIGHT_MAIN()
{
    sVar212 = FLD_PC_GET_RESHND(0);
    RAT_SETUP_POSITION();
    
    if (FLD_CHECK_SUBJECT_MODE() == 0)
    {
        RAT_IN_SET_PLAYER();
        RAT_IN_SET_CAMERA();
        RAT_IN_MOVE();
        RAT_IN_END();
    }
    else if (FLD_CHECK_SUBJECT_MODE() == 1)
    {
        RAT_OUT_SET_CAMERA();
        RAT_OUT_SET_PLAYER();
        RAT_OUT_END();
    }

    RAT_VARIABLE_INITIALIZATION();
    return;
}


