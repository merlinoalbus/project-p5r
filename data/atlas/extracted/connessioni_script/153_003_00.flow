    FLD_MODEL_SYNC_VISIBLE(sVar255);
    FLD_MODEL_SET_VISIBLE(sVar255, 1, 10);
    return;
}


// Procedure Index: 156
void RAT_OUT_END()
{
    
    if (sVar260 != 1)
    {
        FLD_ROT_CAMERA(0, 0);
        FLD_CAMERA_INTERP(15);
        FLD_CAMERA_SYNC_INTERP();
        FLD_CAMERA_UNLOCK();
    }

    MDL_ANIM(sVar255, 0, 1, 5, 1.00f);
    FLD_PTY_MODEL_SET_VISIBLE(1, 10);
    FLD_WAIT(5);
    FLD_MODEL_SYNC_VISIBLE(sVar255);
    FLD_MODEL_SET_VISIBLE(sVar255, 1, 0);
    return;
}


