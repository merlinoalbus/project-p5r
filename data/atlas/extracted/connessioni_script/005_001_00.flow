// Procedure Index: 113
void position_rotate()
{
    float fVar18;
    float fVar21;
    float fVar25;
    float fVar19;
    float fVar22;
    float fVar26;
    float fVar20;
    float fVar23;
    float fVar27;
    float fVar24;
    float fVar28;
    float fVar29;
    fVar25 = (fVar21 - fVar18);
    fVar26 = (fVar22 - fVar19);
    fVar27 = (fVar23 - fVar20);
    fVar28 = SIN(fVar24);
    fVar29 = COS(fVar24);
    fVar21 = ((fVar25 * fVar29) + (fVar27 * fVar28));
    fVar22 = fVar26;
    fVar23 = ((fVar27 * fVar29) - (fVar25 * fVar28));
    fVar21 = (fVar21 + fVar18);
    fVar22 = (fVar22 + fVar19);
    fVar23 = (fVar23 + fVar20);
}


