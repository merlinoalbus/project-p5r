// Procedure Index: 69
void SUB_PhoneCall()
{
    sVar140 = FLD_PC_GET_RESHND(0);
    
    if (FLD_UMBREALLA_CHECK_USE() == 1)
    {
        sVar141 = FLD_MODEL_ADDMOTION_LOAD(sVar140, 101);
    }
    else 
    {
        sVar141 = FLD_MODEL_ADDMOTION_LOAD(sVar140, 1);
    }

    FLD_MODEL_LOADSYNC(sVar141);
    FLD_MODEL_COPY_POSE_ANIM(sVar141, sVar140);
    FLD_MODEL_SET_VISIBLE(sVar140, 0, 0);
    FLD_MODEL_SET_VISIBLE(sVar141, 1, 0);
    FLD_CELLPHONE_MODEL_VISIBLE(sVar141, 1);
    MDL_ANIM(sVar141, (60 + 0), 0, 5, 1.00f);
    MDL_ANIM_NEXT(sVar141, (60 + 1), 1, 0, 1.00f);
    sVar139 = 2;
    WAIT(30);
    return;
}


// Procedure Index: 70
void SUB_PhoneTalk()
{
    SUB_PhonePickup();
    SUB_PhoneCall();
    return;
}


// Procedure Index: 71
void SUB_PhoneEnd()
{
    
    if (sVar139 == 0)
    {
        return;
    }

    
    if (sVar139 != 2)
    {
        FLD_SET_CELLPHONE(0);
    }
    else 
    {
        FLD_MODEL_SET_VISIBLE(sVar140, 0, 0);
        FLD_MODEL_SET_VISIBLE(sVar141, 1, 0);
        MDL_ANIM(sVar141, (60 + 2), 0, 10, 1.00f);
        WAIT(65);
        FLD_CELLPHONE_MODEL_VISIBLE(sVar141, 0);
        MDL_ANIM_SYNC(sVar141);
        MDL_ANIM(sVar141, 0, 1, 0, 1.00f);
        MDL_ANIM_BLENDSYNC(sVar141);
        FLD_MODEL_COPY_POSE_ANIM(sVar140, sVar141);
        FLD_MODEL_SET_VISIBLE(sVar140, 1, 0);
        FLD_MODEL_SET_VISIBLE(sVar141, 0, 0);
        FLD_MODEL_FREE(sVar141);
        FLD_SET_CELLPHONE(0);
    }

    sVar139 = 0;
    return;
}

