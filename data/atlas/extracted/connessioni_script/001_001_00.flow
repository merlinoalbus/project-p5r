    SUB_MoruShowFace();
    MSG_WND_DSP();
    MSG(MSG_MONEY_MORGANA_CHK_00, 0);
    MSG_WND_CLS();
    
    if (var132 >= var130)
    {
        MDL_ADD_ANIM(var131, 15, 0, 0, 1.00f);
        WAIT(30);
        CALL_GLOBAL_MONEY_PANEL();
        CHANGE_GLOBAL_MONEY(-var130, 0);
        DEL_GLOBAL_MONEY_PANEL();
        WAIT(60);
        SUB_MoruReturnBag();
    }
    else 
    {
        MDL_ADD_ANIM(var131, 0x10, 0, 0, 1.00f);
        WAIT(30);
        CALL_GLOBAL_MONEY_PANEL();
        MSG_WND_DSP();
        MSG(MSG_MONEY_MORGANA_CHK_01, 0);
        MSG_WND_CLS();
        CHANGE_GLOBAL_MONEY(-var132, 0);
        DEL_GLOBAL_MONEY_PANEL();
        WAIT(60);
        SUB_MoruReturnBag();
    }

}


