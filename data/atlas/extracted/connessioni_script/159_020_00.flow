// Procedure Index: 183
void add_motion_wait()
{
    int var229;
    var229 = FLD_PC_GET_RESHND(0);
    FLD_MODEL_ANIM_SYNC(sVar215);
    
    if (sVar216 == 1)
    {
        FLD_MODEL_ANIM(sVar215, 0, 1, 5, 1.00f);
    }
    else if (sVar216 == 2)
    {
        FLD_MODEL_ANIM(sVar215, 58, 1, 5, 1.00f);
    }

    FLD_MODEL_REVERT_ADDMOTION(var229, sVar215);
    sVar215 = 0;
    sVar216 = 0;
    return;
}


