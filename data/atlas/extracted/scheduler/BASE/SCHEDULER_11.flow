// Procedure Index: 342
void sdl_shido_after_yokoku()
{
    int var117;
    // bit id (536870912) + (2702) = 8846
    // bit id (536870912) + (2700) = 8844
    // bit id (1073741824) + (16) = 11792
    // bit id (1073741824) + (16) = 11792
    // bit id (1073741824) + (16) = 11792
    // bit id (536870912) + (80) = 6224
    // bit id (536870912) + (3) = 6147
    
    if ((BIT_CHK((0x20000000 + 2702)) == 1) && (BIT_CHK((0x20000000 + 2700)) == 0))
    {
        var117 = 0;
        
        if (GET_WEATHER() == 1)
        {
            var117 = 1;
            BIT_ON((0x40000000 + 0x10));
        }

        SCENE_CHANGE_WAIT();
        FADEOUT(0, 10);
        FADE_SYNC();
        MOVIE_PLAY(25);
        MOVIE_SYNC();
        FADEOUT(0, 10);
        FADE_SYNC();
        CALL_EVENT(416, 1);
        CALL_EVENT(415, 1);
        CALL_EVENT(417, 1);
        CALL_EVENT(419, 1);
        
        if (var117 == 1)
        {
            BIT_OFF((0x40000000 + 0x10));
        }

        PUSH_WEATHER(2);
        CALL_EVENT(420, 1);
        CALL_EVENT(421, 1);
        
        if ((((((((CMM_GET_LV(11) == 10) || (CMM_GET_LV(27) == 10)) || (CMM_GET_LV(13) == 10)) || ((CMM_GET_LV(14) == 10) || (CMM_GET_LV(28) == 10))) || ((CMM_GET_LV(15) == 10) || (CMM_GET_LV(29) == 10))) || (CMM_GET_LV(17) == 10)) || ((CMM_GET_LV(18) == 10) || (CMM_GET_LV(31) == 10))) || (CMM_GET_LV(20) == 10))
        {
            CALL_EVENT(421, 101);
        }

        CLEAR_WEATHER();
        
        if (var117 == 1)
        {
            BIT_ON((0x40000000 + 0x10));
        }

        BIT_ON((0x20000000 + 80));
        BIT_ON((0x20000000 + 3));
        CALL_FIELD(159, 1, 0, 0);
    }
    else 
    {
        KeyFree_Night();
    }

    return;
}


