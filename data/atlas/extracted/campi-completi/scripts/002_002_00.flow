// Procedure Index: 67
void position_rotate()
{
    float fVar4;
    float fVar7;
    float fVar11;
    float fVar5;
    float fVar8;
    float fVar12;
    float fVar6;
    float fVar9;
    float fVar13;
    float fVar10;
    float fVar14;
    float fVar15;
    fVar11 = (fVar7 - fVar4);
    fVar12 = (fVar8 - fVar5);
    fVar13 = (fVar9 - fVar6);
    fVar14 = SIN(fVar10);
    fVar15 = COS(fVar10);
    fVar7 = ((fVar11 * fVar15) + (fVar13 * fVar14));
    fVar8 = fVar12;
    fVar9 = ((fVar13 * fVar15) - (fVar11 * fVar14));
    fVar7 = (fVar7 + fVar4);
    fVar8 = (fVar8 + fVar5);
    fVar9 = (fVar9 + fVar6);
}


