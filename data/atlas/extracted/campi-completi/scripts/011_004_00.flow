    FLD_SET_CELLPHONE(1);
    WAIT(15);
    sVar99 = 1;
    return;
}


// Procedure Index: 58
void SUB_PhoneCall()
{
    sVar100 = FLD_PC_GET_RESHND(0);
    
    if (FLD_UMBREALLA_CHECK_USE() == 1)
    {
        sVar101 = FLD_MODEL_ADDMOTION_LOAD(sVar100, 101);
    }
    else 
    {
        sVar101 = FLD_MODEL_ADDMOTION_LOAD(sVar100, 1);
    }

    FLD_MODEL_LOADSYNC(sVar101);
    FLD_MODEL_COPY_POSE_ANIM(sVar101, sVar100);
    FLD_MODEL_SET_VISIBLE(sVar100, 0, 0);
    FLD_MODEL_SET_VISIBLE(sVar101, 1, 0);
    FLD_CELLPHONE_MODEL_VISIBLE(sVar101, 1);
    MDL_ANIM(sVar101, (60 + 0), 0, 5, 1.00f);
    MDL_ANIM_NEXT(sVar101, (60 + 1), 1, 0, 1.00f);
    sVar99 = 2;
    WAIT(30);
    return;
}


// Procedure Index: 59
void SUB_PhoneTalk()
{
    SUB_PhonePickup();
    SUB_PhoneCall();
    return;
}


// Procedure Index: 60
void SUB_PhoneEnd()
{
    
    if (sVar99 == 0)
    {
        return;
    }

    
    if (sVar99 != 2)
    {
        FLD_SET_CELLPHONE(0);
    }
    else 
    {
        FLD_MODEL_SET_VISIBLE(sVar100, 0, 0);
        FLD_MODEL_SET_VISIBLE(sVar101, 1, 0);
        MDL_ANIM(sVar101, (60 + 2), 0, 10, 1.00f);
        WAIT(65);
        FLD_CELLPHONE_MODEL_VISIBLE(sVar101, 0);
        MDL_ANIM_SYNC(sVar101);
        MDL_ANIM(sVar101, 0, 1, 0, 1.00f);
        MDL_ANIM_BLENDSYNC(sVar101);
        FLD_MODEL_COPY_POSE_ANIM(sVar100, sVar101);
        FLD_MODEL_SET_VISIBLE(sVar100, 1, 0);
        FLD_MODEL_SET_VISIBLE(sVar101, 0, 0);
        FLD_MODEL_FREE(sVar101);
        FLD_SET_CELLPHONE(0);
    }

    sVar99 = 0;
    return;
}

