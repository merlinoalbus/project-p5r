    FLD_MODEL_SET_ROTATE(sVar21, 0, sfVar7, 0, 0);
    FLD_MODEL_SET_VISIBLE(sVar21, 0, 5);
    FLD_SET_SUBJECT_MODE(1);
    FLD_ROT_CAMERA(0, 0);
    FLD_CAMERA_SYNC_INTERP();
    FLD_CAMERA_INTERP(15);
    FLD_CAMERA_SYNC_INTERP();
    FLD_CAMERA_UNLOCK();
    FLD_MODEL_SET_VISIBLE(sVar21, 1, 0);
}


