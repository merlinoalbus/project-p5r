}


// Procedure Index: 71
void SUB_PhonePickup()
{
    sVar132 = 0;
    FLD_SET_CELLPHONE(1);
    WAIT(15);
    sVar132 = 1;
    return;
}


// Procedure Index: 72
void SUB_PhoneCall()
{
    sVar133 = FLD_PC_GET_RESHND(0);
    
    if (FLD_UMBREALLA_CHECK_USE() == 1)
    {
        sVar134 = FLD_MODEL_ADDMOTION_LOAD(sVar133, 101);
    }
    else 
    {
        sVar134 = FLD_MODEL_ADDMOTION_LOAD(sVar133, 1);
    }

    FLD_MODEL_LOADSYNC(sVar134);
    FLD_MODEL_COPY_POSE_ANIM(sVar134, sVar133);
    FLD_MODEL_SET_VISIBLE(sVar133, 0, 0);
    FLD_MODEL_SET_VISIBLE(sVar134, 1, 0);
    FLD_CELLPHONE_MODEL_VISIBLE(sVar134, 1);
    MDL_ANIM(sVar134, (60 + 0), 0, 5, 1.00f);
    MDL_ANIM_NEXT(sVar134, (60 + 1), 1, 0, 1.00f);
    sVar132 = 2;
    WAIT(30);
    return;
}


// Procedure Index: 73
void SUB_PhoneTalk()
{
    SUB_PhonePickup();
    SUB_PhoneCall();
    return;
}


// Procedure Index: 74
void SUB_PhoneEnd()
{
    
    if (sVar132 == 0)
    {
        return;
    }

    
    if (sVar132 != 2)
    {
        FLD_SET_CELLPHONE(0);
    }
    else 
    {
        FLD_MODEL_SET_VISIBLE(sVar133, 0, 0);
        FLD_MODEL_SET_VISIBLE(sVar134, 1, 0);
        MDL_ANIM(sVar134, (60 + 2), 0, 10, 1.00f);
        WAIT(65);
        FLD_CELLPHONE_MODEL_VISIBLE(sVar134, 0);
        MDL_ANIM_SYNC(sVar134);
        MDL_ANIM(sVar134, 0, 1, 0, 1.00f);
        MDL_ANIM_BLENDSYNC(sVar134);
        FLD_MODEL_COPY_POSE_ANIM(sVar133, sVar134);
        FLD_MODEL_SET_VISIBLE(sVar133, 1, 0);
        FLD_MODEL_SET_VISIBLE(sVar134, 0, 0);
        FLD_MODEL_FREE(sVar134);
        FLD_SET_CELLPHONE(0);
    }

    sVar132 = 0;
    return;
}

