    sfVar5 = (sfVar5 + sfVar2);
}


// Procedure Index: 68
void Position_TurnBack()
{
    int var131;
    var131 = FLD_PC_GET_RESHND(0);
    FLD_MODEL_DIR_TRANSLATE(var131, sVar130, 200, 0);
    FLD_MODEL_SYNC_TRANSLATE(var131);
    FLD_UNIT_SET_WAIT(var131);
}


// Procedure Index: 69
void SUB_PhoneRing()
{
    int var135;
    var135 = FLD_PC_GET_RESHND(0);
    MDL_ICON(var135, 15);
    FLD_COMSE_PLAY(1048);
