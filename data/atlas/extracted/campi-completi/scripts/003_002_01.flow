// Procedure Index: 157
void position_rotate()
{
    float fVar9;
    float fVar10;
    float fVar11;
    float fVar12;
    float fVar13;
    fVar9 = (sfVar5 - sfVar2);
    fVar10 = (sfVar6 - sfVar3);
    fVar11 = (sfVar7 - sfVar4);
    fVar12 = SIN(sfVar8);
    fVar13 = COS(sfVar8);
    sfVar5 = ((fVar9 * fVar13) + (fVar11 * fVar12));
    sfVar6 = fVar10;
    sfVar7 = ((fVar11 * fVar13) - (fVar9 * fVar12));
    sfVar5 = (sfVar5 + sfVar2);
    sfVar6 = (sfVar6 + sfVar3);
    sfVar7 = (sfVar7 + sfVar4);
}


