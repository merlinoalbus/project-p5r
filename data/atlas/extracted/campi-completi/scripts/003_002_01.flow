// Procedure Index: 152
void SUB_PhoneCall()
{
    sVar198 = FLD_PC_GET_RESHND(0);
    
    if (FLD_UMBREALLA_CHECK_USE() == 1)
    {
        sVar199 = FLD_MODEL_ADDMOTION_LOAD(sVar198, 101);
    }
    else 
    {
        sVar199 = FLD_MODEL_ADDMOTION_LOAD(sVar198, 1);
    }

    FLD_MODEL_LOADSYNC(sVar199);
    FLD_MODEL_COPY_POSE_ANIM(sVar199, sVar198);
    FLD_MODEL_SET_VISIBLE(sVar198, 0, 0);
    FLD_MODEL_SET_VISIBLE(sVar199, 1, 0);
    FLD_CELLPHONE_MODEL_VISIBLE(sVar199, 1);
    MDL_ANIM(sVar199, (60 + 0), 0, 5, 1.00f);
    MDL_ANIM_NEXT(sVar199, (60 + 1), 1, 0, 1.00f);
    sVar197 = 2;
    WAIT(30);
    return;
}


// Procedure Index: 153
void SUB_PhoneTalk()
{
    SUB_PhonePickup();
    SUB_PhoneCall();
    return;
}


// Procedure Index: 154
void SUB_PhoneEnd()
{
    
    if (sVar197 == 0)
    {
        return;
    }

    
    if (sVar197 != 2)
    {
        FLD_SET_CELLPHONE(0);
    }
    else 
    {
        FLD_MODEL_SET_VISIBLE(sVar198, 0, 0);
        FLD_MODEL_SET_VISIBLE(sVar199, 1, 0);
        MDL_ANIM(sVar199, (60 + 2), 0, 10, 1.00f);
        WAIT(65);
        FLD_CELLPHONE_MODEL_VISIBLE(sVar199, 0);
        MDL_ANIM_SYNC(sVar199);
        MDL_ANIM(sVar199, 0, 1, 0, 1.00f);
        MDL_ANIM_BLENDSYNC(sVar199);
        FLD_MODEL_COPY_POSE_ANIM(sVar198, sVar199);
        FLD_MODEL_SET_VISIBLE(sVar198, 1, 0);
        FLD_MODEL_SET_VISIBLE(sVar199, 0, 0);
        FLD_MODEL_FREE(sVar199);
        FLD_SET_CELLPHONE(0);
    }

    sVar197 = 0;
    return;
}


