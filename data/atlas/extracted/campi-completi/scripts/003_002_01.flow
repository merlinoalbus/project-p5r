// Procedure Index: 43
void SUB_KFEVT_0410_TEL_RING()
{
    FLD_CAMERA_LOCK();
    sVar0 = FLD_PC_GET_RESHND(0);
    BGENV_SE_PLAY_CUEID(103);
    
    if (FLD_LOCAL_FLAG_CHK((49152 + 0)) == 0)
    {
        WAIT(60);
    }
    else 
    {
        WAIT(50);
        FLD_MODEL_SET_ROTATE(sVar0, 0, 180, 0, 13);
        MDL_ANIM(sVar0, 1, 0, 5, 1.00f);
        WAIT(13);
        MDL_ANIM(sVar0, 0, 0, 3, 1.00f);
    }

    SUB_PhonePickup();
    MSG_WND_DSP();
    MSG_MIND(fev0410_04_mes01, 0);
    MSG_WND_CLS();
    SUB_PhoneEnd();
    WAIT(40);
    
    if (FLD_LOCAL_FLAG_CHK((49152 + 0)) == 0)
    {
        FLD_MODEL_SET_ROTATE(sVar0, 0, 180, 0, 7);
        MDL_ANIM(sVar0, 1, 0, 3, 1.00f);
        WAIT(7);
    }

    MDL_ANIM(sVar0, 0, 0, 3, 1.00f);
    MSG_WND_DSP();
    MSG_MIND(fev0410_04_mes02, 0);
    MSG_WND_CLS();
    SET_COUNT(0x10, 105303);
    // bit id (0) + (1094) = 1094
    BIT_ON((0 + 1094));
    SET_COUNT(155, 10530110);
    FLD_MODEL_SYNC_TRANSLATE(sVar0);
    SYNC();
    FLD_CAMERA_SYNC_INTERP();
    FLD_CAMERA_UNLOCK();
}


