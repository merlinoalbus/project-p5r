// Procedure Index: 86
void SUB_PhoneCall()
{
    sVar157 = FLD_PC_GET_RESHND(0);
    
    if (FLD_UMBREALLA_CHECK_USE() == 1)
    {
        sVar158 = FLD_MODEL_ADDMOTION_LOAD(sVar157, 101);
    }
    else 
    {
        sVar158 = FLD_MODEL_ADDMOTION_LOAD(sVar157, 1);
    }

    FLD_MODEL_LOADSYNC(sVar158);
    FLD_MODEL_COPY_POSE_ANIM(sVar158, sVar157);
    FLD_MODEL_SET_VISIBLE(sVar157, 0, 0);
    FLD_MODEL_SET_VISIBLE(sVar158, 1, 0);
    FLD_CELLPHONE_MODEL_VISIBLE(sVar158, 1);
    MDL_ANIM(sVar158, (60 + 0), 0, 5, 1.00f);
    MDL_ANIM_NEXT(sVar158, (60 + 1), 1, 0, 1.00f);
    sVar156 = 2;
    WAIT(30);
    return;
}


// Procedure Index: 87
void SUB_PhoneTalk()
{
    SUB_PhonePickup();
    SUB_PhoneCall();
    return;
}


// Procedure Index: 88
void SUB_PhoneEnd()
{
    
    if (sVar156 == 0)
    {
        return;
    }

    
    if (sVar156 != 2)
    {
        FLD_SET_CELLPHONE(0);
    }
    else 
    {
        FLD_MODEL_SET_VISIBLE(sVar157, 0, 0);
        FLD_MODEL_SET_VISIBLE(sVar158, 1, 0);
        MDL_ANIM(sVar158, (60 + 2), 0, 10, 1.00f);
        WAIT(65);
        FLD_CELLPHONE_MODEL_VISIBLE(sVar158, 0);
        MDL_ANIM_SYNC(sVar158);
        MDL_ANIM(sVar158, 0, 1, 0, 1.00f);
        MDL_ANIM_BLENDSYNC(sVar158);
        FLD_MODEL_COPY_POSE_ANIM(sVar157, sVar158);
        FLD_MODEL_SET_VISIBLE(sVar157, 1, 0);
        FLD_MODEL_SET_VISIBLE(sVar158, 0, 0);
        FLD_MODEL_FREE(sVar158);
        FLD_SET_CELLPHONE(0);
    }

    sVar156 = 0;
    return;
}


