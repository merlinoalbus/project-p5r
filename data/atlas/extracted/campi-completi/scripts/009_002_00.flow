// Procedure Index: 90
void SUB_AllCinema_main()
{
    int var162;
    int var163;
    var162 = 0;
    SUB_TAG_Set_Title();
    // bit id (268435456) + (1225) = 4297
    // bit id (268435456) + (1225) = 4297
    
    if (BIT_CHK((0x10000000 + 1225)) == 0)
    {
        CALL_TUTORIAL(2, 29);
        BIT_ON((0x10000000 + 1225));
    }

    sVar161 = 0;
    SUB_CinemaNG_CHECK();
    
    if (sVar161 == 1)
    {
        return;
    }

    SUB_CinemaComment_Common();
    MSG_WND_DSP();
    MSG(MSG_CinemaBuyTicket, 0);
    MSG_WND_CLS();
    
    if (FLD_GET_MAJOR() == 1)
    {
        var162 = 66;
    }
    else if (FLD_GET_MAJOR() == 6)
    {
        var162 = 67;
    }
    else if (FLD_GET_MAJOR() == 9)
    {
        var162 = 68;
    }

    var163 = CALL_PUBLIC_SHOP(var162);
    
    if (var163 == -3)
    {
        MSG_WND_DSP();
        MSG(MSG_CinemaOK, 0);
        MSG_WND_CLS();
        FLD_LOCAL_FLAG_ON((49152 + 49));
    }
    else if (var163 == 0)
    {
        MSG_WND_DSP();
        MSG(MSG_CinemaCancel, 0);
        MSG_WND_CLS();
        return;
    }

    return;
}


