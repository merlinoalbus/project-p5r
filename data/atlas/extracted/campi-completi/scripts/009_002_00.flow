// Procedure Index: 81
void position_rotate()
{
    float fVar7;
    float fVar8;
    float fVar9;
    float fVar10;
    float fVar11;
    fVar7 = (sfVar3 - sfVar0);
    fVar8 = (sfVar4 - sfVar1);
    fVar9 = (sfVar5 - sfVar2);
    fVar10 = SIN(sfVar6);
    fVar11 = COS(sfVar6);
    sfVar3 = ((fVar7 * fVar11) + (fVar9 * fVar10));
    sfVar4 = fVar8;
    sfVar5 = ((fVar9 * fVar11) - (fVar7 * fVar10));
    sfVar3 = (sfVar3 + sfVar0);
    sfVar4 = (sfVar4 + sfVar1);
    sfVar5 = (sfVar5 + sfVar2);
}


