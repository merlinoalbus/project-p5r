// Procedure Index: 41
void SUB_PhonePickup()
{
    sVar58 = 0;
    FLD_SET_CELLPHONE(1);
    WAIT(15);
    sVar58 = 1;
    return;
}


// Procedure Index: 42
void SUB_PhoneCall()
{
    sVar59 = FLD_PC_GET_RESHND(0);
    
    if (FLD_UMBREALLA_CHECK_USE() == 1)
    {
        sVar60 = FLD_MODEL_ADDMOTION_LOAD(sVar59, 101);
    }
    else 
    {
        sVar60 = FLD_MODEL_ADDMOTION_LOAD(sVar59, 1);
    }

    FLD_MODEL_LOADSYNC(sVar60);
    FLD_MODEL_COPY_POSE_ANIM(sVar60, sVar59);
    FLD_MODEL_SET_VISIBLE(sVar59, 0, 0);
    FLD_MODEL_SET_VISIBLE(sVar60, 1, 0);
    FLD_CELLPHONE_MODEL_VISIBLE(sVar60, 1);
    MDL_ANIM(sVar60, (60 + 0), 0, 5, 1.00f);
    MDL_ANIM_NEXT(sVar60, (60 + 1), 1, 0, 1.00f);
    sVar58 = 2;
    WAIT(30);
    return;
}


// Procedure Index: 43
void SUB_PhoneTalk()
{
    SUB_PhonePickup();
    SUB_PhoneCall();
    return;
}


// Procedure Index: 44
void SUB_PhoneEnd()
{
    
    if (sVar58 == 0)
    {
        return;
    }

    
    if (sVar58 != 2)
    {
        FLD_SET_CELLPHONE(0);
    }
    else 
    {
        FLD_MODEL_SET_VISIBLE(sVar59, 0, 0);
        FLD_MODEL_SET_VISIBLE(sVar60, 1, 0);
        MDL_ANIM(sVar60, (60 + 2), 0, 10, 1.00f);
        WAIT(65);
        FLD_CELLPHONE_MODEL_VISIBLE(sVar60, 0);
        MDL_ANIM_SYNC(sVar60);
        MDL_ANIM(sVar60, 0, 1, 0, 1.00f);
        MDL_ANIM_BLENDSYNC(sVar60);
        FLD_MODEL_COPY_POSE_ANIM(sVar59, sVar60);
        FLD_MODEL_SET_VISIBLE(sVar59, 1, 0);
        FLD_MODEL_SET_VISIBLE(sVar60, 0, 0);
        FLD_MODEL_FREE(sVar60);
        FLD_SET_CELLPHONE(0);
    }

    sVar58 = 0;
    return;
}

