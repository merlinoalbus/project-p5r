{
    int var88;
    int var87;
    var88 = FLD_PC_GET_RESHND(0);
    FLD_MODEL_DIR_TRANSLATE(var88, var87, 200, 0);
    FLD_MODEL_SYNC_TRANSLATE(var88);
    FLD_UNIT_SET_WAIT(var88);
}


// Procedure Index: 57
void SUB_PhoneRing()
{
    int var92;
    var92 = FLD_PC_GET_RESHND(0);
    MDL_ICON(var92, 15);
    FLD_COMSE_PLAY(1048);
    WAIT(10);
    RUMBLE_START_S(6, 12, 2, 30);
    WAIT(30);
    return;
}


// Procedure Index: 58
void SUB_PhoneRumble()
{
    int var93;
    var93 = FLD_PC_GET_RESHND(0);
    MDL_ICON(var93, 18);
    FLD_COMSE_PLAY(1047);
    WAIT(10);
    RUMBLE_START_S(6, 12, 2, 30);
    WAIT(30);
    return;
}


// Procedure Index: 59
void SUB_PhonePickup()
{
    sVar89 = 0;
    FLD_SET_CELLPHONE(1);
    WAIT(15);
    sVar89 = 1;
    return;
}


// Procedure Index: 60
void SUB_PhoneCall()
{
    sVar90 = FLD_PC_GET_RESHND(0);
    
    if (FLD_UMBREALLA_CHECK_USE() == 1)
    {
        sVar91 = FLD_MODEL_ADDMOTION_LOAD(sVar90, 101);
    }
    else 
    {
        sVar91 = FLD_MODEL_ADDMOTION_LOAD(sVar90, 1);
    }

    FLD_MODEL_LOADSYNC(sVar91);
    FLD_MODEL_COPY_POSE_ANIM(sVar91, sVar90);
    FLD_MODEL_SET_VISIBLE(sVar90, 0, 0);
    FLD_MODEL_SET_VISIBLE(sVar91, 1, 0);
    FLD_CELLPHONE_MODEL_VISIBLE(sVar91, 1);
    MDL_ANIM(sVar91, (60 + 0), 0, 5, 1.00f);
    MDL_ANIM_NEXT(sVar91, (60 + 1), 1, 0, 1.00f);
    sVar89 = 2;
    WAIT(30);
    return;
}


// Procedure Index: 61
void SUB_PhoneTalk()
{
    SUB_PhonePickup();
    SUB_PhoneCall();
    return;
}


// Procedure Index: 62
void SUB_PhoneEnd()
{
    
    if (sVar89 == 0)
    {
        return;
    }

    
    if (sVar89 != 2)
    {
        FLD_SET_CELLPHONE(0);
    }
    else 
    {
        FLD_MODEL_SET_VISIBLE(sVar90, 0, 0);
        FLD_MODEL_SET_VISIBLE(sVar91, 1, 0);
        MDL_ANIM(sVar91, (60 + 2), 0, 10, 1.00f);
        WAIT(65);
        FLD_CELLPHONE_MODEL_VISIBLE(sVar91, 0);
        MDL_ANIM_SYNC(sVar91);
        MDL_ANIM(sVar91, 0, 1, 0, 1.00f);
        MDL_ANIM_BLENDSYNC(sVar91);
        FLD_MODEL_COPY_POSE_ANIM(sVar90, sVar91);
        FLD_MODEL_SET_VISIBLE(sVar90, 1, 0);
        FLD_MODEL_SET_VISIBLE(sVar91, 0, 0);
        FLD_MODEL_FREE(sVar91);
        FLD_SET_CELLPHONE(0);
    }

    sVar89 = 0;
    return;
}

