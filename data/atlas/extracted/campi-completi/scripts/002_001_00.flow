// Procedure Index: 35
void SUB_PhonePickup()
{
    sVar50 = 0;
    FLD_SET_CELLPHONE(1);
    WAIT(15);
    sVar50 = 1;
    return;
}


// Procedure Index: 36
void SUB_PhoneCall()
{
    sVar51 = FLD_PC_GET_RESHND(0);
    
    if (FLD_UMBREALLA_CHECK_USE() == 1)
    {
        sVar52 = FLD_MODEL_ADDMOTION_LOAD(sVar51, 101);
    }
    else 
    {
        sVar52 = FLD_MODEL_ADDMOTION_LOAD(sVar51, 1);
    }

    FLD_MODEL_LOADSYNC(sVar52);
    FLD_MODEL_COPY_POSE_ANIM(sVar52, sVar51);
    FLD_MODEL_SET_VISIBLE(sVar51, 0, 0);
    FLD_MODEL_SET_VISIBLE(sVar52, 1, 0);
    FLD_CELLPHONE_MODEL_VISIBLE(sVar52, 1);
    MDL_ANIM(sVar52, (60 + 0), 0, 5, 1.00f);
    MDL_ANIM_NEXT(sVar52, (60 + 1), 1, 0, 1.00f);
    sVar50 = 2;
    WAIT(30);
    return;
}


// Procedure Index: 37
void SUB_PhoneTalk()
{
    SUB_PhonePickup();
    SUB_PhoneCall();
    return;
}


// Procedure Index: 38
void SUB_PhoneEnd()
{
    
    if (sVar50 == 0)
    {
        return;
    }

    
    if (sVar50 != 2)
    {
        FLD_SET_CELLPHONE(0);
    }
    else 
    {
        FLD_MODEL_SET_VISIBLE(sVar51, 0, 0);
        FLD_MODEL_SET_VISIBLE(sVar52, 1, 0);
        MDL_ANIM(sVar52, (60 + 2), 0, 10, 1.00f);
        WAIT(65);
        FLD_CELLPHONE_MODEL_VISIBLE(sVar52, 0);
        MDL_ANIM_SYNC(sVar52);
        MDL_ANIM(sVar52, 0, 1, 0, 1.00f);
        MDL_ANIM_BLENDSYNC(sVar52);
        FLD_MODEL_COPY_POSE_ANIM(sVar51, sVar52);
        FLD_MODEL_SET_VISIBLE(sVar51, 1, 0);
        FLD_MODEL_SET_VISIBLE(sVar52, 0, 0);
        FLD_MODEL_FREE(sVar52);
        FLD_SET_CELLPHONE(0);
    }

    sVar50 = 0;
    return;
}

