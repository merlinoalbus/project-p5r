    SUB_PhoneCall();
    return;
}


// Procedure Index: 78
void SUB_PhoneEnd()
{
    
    if (sVar159 == 0)
    {
        return;
    }

    
    if (sVar159 != 2)
    {
        FLD_SET_CELLPHONE(0);
    }
    else 
    {
        FLD_MODEL_SET_VISIBLE(sVar160, 0, 0);
        FLD_MODEL_SET_VISIBLE(sVar161, 1, 0);
        MDL_ANIM(sVar161, (60 + 2), 0, 10, 1.00f);
        WAIT(65);
