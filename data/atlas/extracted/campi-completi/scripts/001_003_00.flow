// Procedure Index: 76
void SUB_PhoneCall()
{
    sVar160 = FLD_PC_GET_RESHND(0);
    
    if (FLD_UMBREALLA_CHECK_USE() == 1)
    {
        sVar161 = FLD_MODEL_ADDMOTION_LOAD(sVar160, 101);
    }
    else 
    {
        sVar161 = FLD_MODEL_ADDMOTION_LOAD(sVar160, 1);
    }

    FLD_MODEL_LOADSYNC(sVar161);
    FLD_MODEL_COPY_POSE_ANIM(sVar161, sVar160);
    FLD_MODEL_SET_VISIBLE(sVar160, 0, 0);
    FLD_MODEL_SET_VISIBLE(sVar161, 1, 0);
    FLD_CELLPHONE_MODEL_VISIBLE(sVar161, 1);
    MDL_ANIM(sVar161, (60 + 0), 0, 5, 1.00f);
    MDL_ANIM_NEXT(sVar161, (60 + 1), 1, 0, 1.00f);
    sVar159 = 2;
    WAIT(30);
    return;
}


