                BIT_OFF((0 + 97));
            }

        }
        else if ((var235 == 1092) && (GET_TIME() == 0))
        {
            
            if (BIT_CHK((0 + 143)) == 0)
            {
                BIT_OFF((0 + 97));
            }
            else 
            {
                BIT_ON((0 + 97));
            }

        }

    }

    // bit id (0) + (97) = 97
    
    if (BIT_CHK((0 + 97)) == 0)
    {
        MDL_TRACK_ADD_ANIM(var238, 1, 2, 1, 0, 1.00f);
        MDL_TRACK_ADD_ANIM(var238, 2, (10 + var237), 1, 0, 1.00f);
    }
    else 
    {
        MDL_TRACK_ADD_ANIM(var238, 1, 0, 1, 0, 1.00f);
