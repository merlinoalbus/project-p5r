        BIT_ON((0 + 97));
        var237 = 1;
    }
    else if (GET_TIME() == 6)
    {
        BIT_OFF((0 + 97));
        var237 = 1;
    }

    // bit id (0) + (536) = 536
    // bit id (0) + (644) = 644
    // bit id (0) + (1125) = 1125
    // bit id (0) + (97) = 97
    
    if (((BIT_CHK((0 + 536)) == 1) || (BIT_CHK((0 + 644)) == 1)) || (BIT_CHK((0 + 1125)) == 1))
    {
