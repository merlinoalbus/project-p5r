void MY_ROOM_CALL_CALENDAR()
{
    // bit id (268435456) + (1845) = 4917
    BIT_ON((0x10000000 + 1845));
    
    if (CHK_DAYS(4, 1) == 1)
    {
        
        if (GET_TIME() == 5)
        {
            SET_DBG_DAY(4, 1, 0);
            CALL_FIELD(3, 2, 20, 1);
        }
        else 
        {
            SET_DBG_DAY(4, 1, 5);
            CALL_FIELD(3, 2, 0, 1);
        }

    }
    else if ((CHK_DAYS_STARTEND(4, 2, 4, 3) == 1) && (GET_TIME() == 5))
    {
        SET_DBG_DAY(4, 2, 5);
        CALL_FIELD(3, 2, 0, 1);
    }
    else 
    {
        CALL_CALENDAR();
    }

}


