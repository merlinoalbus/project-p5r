{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // Risoluzione bundler così i test BE (import con estensione `.js`) e
    // FE (import relativi nudi) passano il typecheck in un unico progetto,
    // esattamente come li esegue Vitest.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "vitest/globals"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "strict": true,
    // gli stessi controlli degli altri progetti: prima mancavano solo qui (rilievo K5‴ della verifica completa)
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx"
  },
  // Tutto il sorgente, non solo i test: il progetto è `composite` (lo vuole `tsc -b`) e un progetto composite deve elencare
  // ogni file che i suoi test importano (TS6307). Limitarlo ai test vorrebbe dire far leggere ai test le dichiarazioni emesse
  // dagli altri progetti, che oggi non emettono nulla (rilievo K5‴: provato il 2026-10-04, 491 errori TS6307).
  "include": [
    "server/**/*.ts",
    "shared/**/*.ts",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    // i test dei plugin di Vite: `tsconfig.node.json` li esclude, e senza questa riga nessun progetto li controllava
    "vite/**/*.ts"
  ],
  "exclude": [
    "server/**/*.d.ts",
    "node_modules",
    "dist"
  ]
}
