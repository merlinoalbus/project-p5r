vite.config.prova.ts

# Cartelle di lavoro degli altri agenti e worktree smontati. Restano su disco quando Windows
# rifiuta di cancellarli, e da smontati git li conta come file nuovi: 11502 in una volta sola.
worktrees/
.codex-temp/
.codex-temp*
.codex-assets*/

# Un backup completo dei dati di gioco (stesso gioco.db con le immagini dentro, centinaia di MB) non va in GitHub: si importa
# dall'app dalla cartella d'appoggio (Impostazioni → Pacchetto di gioco). In git c'è pacchetto/gioco.db iniziale (senza immagini).
pacchetto/completo/

# Cartella d'appoggio di prova in locale (i file pesano centinaia di MB)
.deposito-prova/
