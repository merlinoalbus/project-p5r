# Log
logs
*.log
npm-debug.log*

# Segreti e dati locali (il seed in data/seed/ è versionato)
.env
data/*.db
data/*.db-shm
data/*.db-wal
data/backups/
data/immagini/
data/font/

# Build
node_modules
dist
dist-ssr
*.local
coverage/

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# PID degli script di gestione server
.pids/
data/tmp/

# Originali dei CPK ripristinati da data/atlas/original-archives (rigenerabili con
# `python tools/p5r-map-export/restore_originals.py`, hash verificati file per file)
data/atlas/extracted/originali/

# Cache dei moduli Python degli strumenti
__pycache__/

# Cartella di lavoro temporanea del verificatore
.codex-temp/
vite.config.prova.ts

# Cartelle di lavoro degli altri agenti e worktree smontati. Restano su disco quando Windows
# rifiuta di cancellarli, e da smontati git li conta come file nuovi: 11502 in una volta sola.
worktrees/
.codex-temp/
.codex-temp*
.codex-assets*/

# Il pacchetto di gioco COMPLETO (stesso gioco.db ma con le immagini dentro, ~311 MB) resta fuori da GitHub (decisione
# dell'utente, 2026-09-12) e vive qui in locale in pacchetto/completo/ (vedi pacchetto/README.md): si carica dall'app con
# «Importa un pacchetto» e sostituisce il file dell'istanza. In git c'è pacchetto/gioco.db iniziale (senza immagini).
pacchetto/completo/
