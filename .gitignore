.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# PID degli script di gestione server
.pids/
data/tmp/

# Configurazione di prova di Vite del verificatore
vite.config.prova.ts

# Cartelle di lavoro degli altri agenti e worktree smontati. Restano su disco quando Windows
# rifiuta di cancellarli, e da smontati git li conta come file nuovi: 11502 in una volta sola.
worktrees/
.codex-temp/
.codex-temp*
.codex-assets*/

# Il pacchetto di gioco COMPLETO (stesso gioco.db ma con le immagini dentro, ~311 MB) resta fuori da GitHub (decisione
# dell'utente, 2026-09-12) e vive qui in locale in pacchetto/completo/ (vedi pacchetto/README.md): si carica dall'app, dalla
# cartella d'appoggio (Impostazioni → Pacchetto di gioco), e sostituisce il file dell'istanza. In git c'è pacchetto/gioco.db
# iniziale (senza immagini).
pacchetto/completo/

# Cartella d'appoggio di prova in locale (i file pesano centinaia di MB)
.deposito-prova/
