# ============================================================
# Dockerfile.frontend — build Vite → nginx statico
# ============================================================

# ---- Stage 1: build ----
FROM node:24.22.1-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
# Senza gli script d'installazione: l'unico che conti qui era la compilazione di better-sqlite3, che il frontend non usa
# (rilievo D9 della verifica completa, 2026-10-04). Vite, esbuild, Rollup e Tailwind portano i loro binari come pacchetti
# opzionali per piattaforma, che `npm ci` installa comunque.
RUN npm ci --ignore-scripts
COPY index.html vite.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json ./
COPY vite/ ./vite/
COPY public/ ./public/
COPY src/ ./src/
COPY shared/ ./shared/
# la guardia del bundle di rilascio (L9-06): la stessa del gate CI, qui sul bundle che finisce davvero nell'immagine
COPY scripts/verifica-bundle-rilascio.ts ./scripts/
# La modalità dell'istanza (L12, passo 9) è fissata QUI, nella build: Vite sostituisce `import.meta.env.VITE_MODALITA` con una costante e gli
# editor escono dal bundle. Vuota (il valore predefinito) = preparazione, l'istanza di oggi: la pipeline di `main` non passa l'argomento e la
# build resta identica. La pipeline del rilascio passa `--build-arg VITE_MODALITA=rilascio`. Va dichiarata subito prima della build, non
# in testa: cambiarla non invalida lo strato di `npm ci`.
ARG VITE_MODALITA=
ENV VITE_MODALITA=$VITE_MODALITA
RUN npm run build && echo "$VITE_MODALITA" > /app/.modalita
# L9-06: un bundle di rilascio deve passare la guardia intera (`scripts/verifica-bundle-rilascio.ts`: i percorsi dell'API che scrivono i contenuti
# e le etichette degli editor, fra cui `/impostazioni/` che copre la rotta di «Prepara edizione»), non una sola stringa. Se fallisce, fallisce la
# costruzione dell'immagine. Nella preparazione non si esegue: quel bundle gli editor li ha, ed è giusto così.
RUN if [ "$VITE_MODALITA" = "rilascio" ]; then npx tsx scripts/verifica-bundle-rilascio.ts dist; fi

# ---- Stage 2a: nginx di RILASCIO (L12, passo 9) ----
# Si costruisce solo con `--target rilascio`. Sta prima dello stage finale apposta: senza `--target` Docker costruisce l'ultimo, che resta quello di
# preparazione. Due controlli sulla build (non test: falliscono la costruzione dell'immagine):
#   1. la build dev'essere stata fatta con VITE_MODALITA=rilascio, altrimenti questa immagine pubblica conterrebbe gli editor;
#   2. quel bundle ha passato la guardia del bundle di rilascio nello stage di build (sopra), che con VITE_MODALITA=rilascio si esegue sempre.
# Il container gira con il filesystem in sola lettura (docker-compose.rilascio.yml): nginx scrive solo nelle tmpfs della cache, del pid e di /tmp.
FROM nginx:1.30-alpine AS rilascio
RUN rm /etc/nginx/conf.d/default.conf
COPY nginx.rilascio.conf /etc/nginx/conf.d/default.conf
COPY nginx.rilascio-intestazioni.conf /etc/nginx/snippets/intestazioni-sicurezza.conf
COPY --from=build /app/dist /usr/share/nginx/html
COPY --from=build /app/.modalita /tmp/modalita
RUN if [ "$(cat /tmp/modalita)" != "rilascio" ]; then echo "ERRORE: lo stage rilascio richiede --build-arg VITE_MODALITA=rilascio" >&2; exit 1; fi
RUN rm -f /tmp/modalita
# la sintassi della configurazione si controlla alla costruzione, non al primo avvio in produzione
RUN nginx -t
EXPOSE 80

# ---- Stage 2: nginx (PREPARAZIONE, lo stage finale) ----
FROM nginx:1.30-alpine
RUN rm /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
