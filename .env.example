# ============================================================
# project-p5r — variabili d'ambiente (template)
# Copia in `.env` per lo sviluppo locale. Il file .env è git-ignored.
# Le legge server/config.ts; le porte anche vite.config.ts e scripts/_comuni.sh.
# ============================================================

# BE_PORT ha precedenza su PORT (alcuni ambienti dev iniettano PORT per
# il dev server FE). Porte scelte per non collidere con project-jira.
BE_PORT=3101
PORT=3101
# Porta del dev server di Vite (e degli script start-fe/stop-fe)
FE_PORT=5273
DATA_DIR=./data
LOG_LEVEL=info

# Cartella del pacchetto di gioco iniziale (pacchetto/gioco.db) e degli asset grafici del repository
PACCHETTO_DIR=./pacchetto
ASSET_DIR=./public/asset

# Cartella d'appoggio da cui importare i pacchetti di gioco (il NAS montato; vuota = funzione disattivata)
# DEPOSITO_DIR=/deposito
